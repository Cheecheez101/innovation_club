{
    "name": "elite-academy/innovation-club",
    "description": "Elite Academy Innovation Club Management System - A comprehensive web application for managing innovation club activities, members, events, and projects",
    "type": "project",
    "version": "1.0.0",
    "keywords": ["innovation", "club", "management", "education", "php", "mysql"],
    "homepage": "https://github.com/elite-academy/innovation-club",
    "license": "MIT",
    "authors": [
        {
            "name": "Diploma in ICT Student",
            "email": "student@eliteacademy.edu",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "support@eliteacademy.edu",
        "issues": "https://github.com/elite-academy/innovation-club/issues"
    },
    "require": {
        "php": ">=7.4.0",
        "ext-pdo": "*",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpmd/phpmd": "^2.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Libraries\\": "app/libraries/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-update-cmd": [
            "@php artisan migrate --seed"
        ],
        "test": "phpunit",
        "check-style": "phpcs --standard=PSR12 app/",
        "fix-style": "phpcbf --standard=PSR12 app/"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}